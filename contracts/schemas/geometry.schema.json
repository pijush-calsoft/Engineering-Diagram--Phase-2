      "type": "string"
    },
    "title_block": {
      "anyOf": [
        {
          "$ref": "#/$defs/TitleBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "units": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Units"
    },
    "views": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Views",
      "type": "array"
    }
  },
  "title": "Geometry",
  "type": "object"
}
