# EDP local configuration template.
# Copy to .env (git-ignored) and fill in locally. Never commit .env or paste keys into chats or docs.
# Blank values are open decisions, not defaults; see docs/open-decisions.md.

# --- Runtime (OD-2: run locally) ------------------------------------------------
EDP_ENV=local

# --- Hosted model APIs (OD-5 / ADR-0005: API calls only, no fine-tuning, no local LLM) ---
# Provider: OpenAI (OD-37, decided 2026-11-24). Model names are not decided yet (OD-43).
# Vision, OCR and symbol reading also use a multimodal model over the API (OD-38, ADR-0007).
# Calls go through the LiteLLM proxy (plan §4.1).
EDP_LLM_PROVIDER=openai
OPENAI_API_KEY=
EDP_LLM_MODEL_TEXT=
EDP_LLM_MODEL_VISION=
EDP_LLM_MODEL_CODE=
# LLM-as-judge for report review (OD-6)
EDP_LLM_MODEL_JUDGE=
# LiteLLM proxy endpoint, built in Phase 1 (platform/gateway)
EDP_GATEWAY_URL=

# --- Golden dataset (OD-7) ------------------------------------------------------
# Output folder for generated synthetic drawings and labels. Git-ignored.
EDP_GOLDEN_DATA_DIR=eval/golden/data

# --- Local data (ADR-0008 local adapters: Fabric files, Catalogue and checkpoints) ---
EDP_DATA_DIR=var

# --- Platform services (Phase 1; stack per plan §4.1, ADR-0002 to 0004) --------
# Left blank until Phase 1 brings the services up locally (needs Docker, OD-21).
EDP_POSTGRES_DSN=
EDP_NATS_URL=
EDP_S3_ENDPOINT=
EDP_S3_ACCESS_KEY=
EDP_S3_SECRET_KEY=
EDP_LAKEFS_ENDPOINT=
EDP_LAKEFS_ACCESS_KEY=
EDP_LAKEFS_SECRET_KEY=
